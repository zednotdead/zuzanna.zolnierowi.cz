---
import type { SectionRendered } from "@/utils/sections";
type Props = SectionRendered;

const { title, content } = Astro.props;
---

<section
  aria-labelledby={`section-${title.toLocaleLowerCase()}`}
  class="prose not-print:prose-invert text-justify prose-headings:print:font-sans text-lg print:prose-headings:my-2 print:prose-p:mb-1"
>
  <h2 id={`section-${title.toLocaleLowerCase()}`}>{title}</h2>
  <Fragment set:html={content} />
</section>
