---
interface Props {
  name: string;
  address: string;
  href?: string;
  icon: string;
  print?: string;
  nolink?: boolean;
}

const { name, address, icon, print, href } = Astro.props;
const baseIconClass = "h-fit w-fit *:size-4 *:aspect-square inline-block mr-2";
const printHiddenClass = print ? "print:hidden" : "";
const url = href ?? address;
---

<a class="inline align-center" href={url}>
  {print && (
    <div class:list={[baseIconClass, "not-print:hidden"]} set:html={print} />
  )}
  <div class:list={[baseIconClass, printHiddenClass]} set:html={icon} />
  <b class="font-black mr-1">{name}:</b> {address}
</a>
