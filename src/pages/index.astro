---
import Base from "@/layouts/base.astro";
import { getSections } from "@/contents/sections";
import { getExperience } from "@/contents/experience";

const sections = await getSections();
const experience = await getExperience();
---

<Base>
  <main class="flex flex-col mx-auto max-w-4xl px-8 gap-4 print:gap-4 my-16">
    <section class="break-after-avoid-page">
      <h1>
        <span class="block text-4xl font-black mb-2">Zuzanna Żołnierowicz</span>
        <span class="block text-3xl font-bold">Software Engineer</span>
      </h1>
    </section>

    {sections.map(({ title, content }) => (
      <section class="prose not-print:prose-invert text-justify prose-headings:print:font-sans text-lg print:prose-headings:my-2 print:prose-p:mb-1">
        <h2>{title}</h2>
        <Fragment set:html={content} />
      </section>
    ))}
    <pre>{JSON.stringify(experience, null, 2)}</pre>
  </main>
</Base>
