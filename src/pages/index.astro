---
import Base from "@/layouts/base.astro";
import { getSections } from "@/contents/sections";
import { getExperience } from "@/contents/experience";

import LinkedIn from "@thesvg/icons/linkedin";
import Github from "@thesvg/icons/github";
import Mail from "@thesvg/icons/mailbox";

import Social from "@/components/social.astro";
import Experience from "@/components/experience.astro";
import Section from "@/components/section.astro";

const sections = await getSections();
const experience = await getExperience();

const socials = [
  {
    name: "Github",
    address: "https://github.com/zednotdead",
    href: "https://github.com/zednotdead",
    icon: Github.variants.dark,
    print: Github.svg,
  },
  {
    name: "LinkedIn",
    address: "https://www.linkedin.com/in/zuzanna-zolnierowicz/",
    href: "https://www.linkedin.com/in/zuzanna-zolnierowicz/",
    icon: LinkedIn.svg,
  },
  {
    name: "Email",
    address: "zuzanna@zolnierowi.cz",
    href: "mailto:zuzanna@zolnierowi.cz",
    icon: Mail.svg,
  },
];
---

<Base title="Zuzanna Żołnierowicz - Software Engineer">
  <main class="gap-4 print:gap-4 my-16 px-4 fullbleed-wrap-4xl fullbleed-padding-2">
    <section
      aria-labelledby="whoami"
      class="flex flex-col break-inside-avoid gap-4"
    >
      <h1 id="whoami">
        <span class="block print:text-4xl md:text-6xl text-3xl font-black mb-4">
          Zuzanna Żołnierowicz
        </span>
        <span class="block md:text-3xl text-2xl font-bold">
          Software Engineer
        </span>
      </h1>

      <ul class="flex flex-col gap-4">
        {socials.map((soc) => (
          <li>
            <Social {...soc} />
          </li>
        ))}
      </ul>
    </section>

    {sections.map((sect) => (
      <Section {...sect} />
    ))}

    <section aria-labelledby="job-experience">
      <h2 class="text-3xl font-bold mb-4" id="job-experience">
        Experience
      </h2>
      <div class="flex flex-col gap-4">
        {experience.map((exp) => (
          <Experience {...exp} />
        ))}
      </div>
    </section>
  </main>
</Base>
