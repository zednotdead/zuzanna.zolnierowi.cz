---
import Base from "../layouts/base.astro";
import * as summaryFile from "../contents/summary.md";
import * as skillsFile from "../contents/skills.md";

const summary = await summaryFile.compiledContent();
const skills = await skillsFile.compiledContent();

const sections = [
  { title: "Summary", content: summary },
  { title: "Skills", content: skills },
];
---

<Base>
  <main class="flex flex-col mx-auto max-w-4xl px-8 gap-8 my-16">
    <section class="break-after-avoid-page">
      <h1>
        <span class="block text-4xl font-black mb-2">Zuzanna Żołnierowicz</span>
        <span class="block text-3xl font-bold">Software Engineer</span>
      </h1>
    </section>

    {sections.map(({ title, content }) => (
      <section class="prose not-print:prose-invert text-justify prose-headings:print:font-sans text-lg">
        <h2>{title}</h2>
        <Fragment set:html={content} />
      </section>
    ))}
  </main>
</Base>
