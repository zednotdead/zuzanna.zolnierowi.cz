---
import "../styles/global.css";
import { Font } from "astro:assets";
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-gambarino" />
    <Font cssVariable="--font-supreme" />
    <title>{title}</title>
  </head>
  <body class="w-full not-print:bg-dots-slate-950 not-print:bg-dots-color-slate-500 not-print:text-white bg-dots-distance-24 print:font-sans-serif">
    <slot />
  </body>
</html>
